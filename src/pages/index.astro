---
import Base from '../layouts/Base.astro';

const mods = import.meta.glob('../../content/home.md', { eager: true });
const { Content, frontmatter } = Object.values(mods)[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={undefined} description={frontmatter.description}>
  <h1 class="visually-hidden">SASE Purdue</h1>

  <figure class="home-photo">
    <img src={`${base}/images/board-group.jpg`} alt="The SASE Purdue board"
         width="1024" height="683" />
  </figure>

  <div class="constrained home-body">
    <Content />
  </div>
</Base>
