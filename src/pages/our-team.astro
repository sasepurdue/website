---
import Base from '../layouts/Base.astro';
import { parseBoard } from '../lib/board.js';

const files = import.meta.glob('../../content/board/*.md', {
  eager: true, query: '?raw', import: 'default',
});
const newest = Object.keys(files).sort().pop();
const sections = newest ? parseBoard(files[newest]) : [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rows = people => people.reduce((acc, p, i) => {
  if (i % 3 === 0) acc.push([]);
  acc[acc.length - 1].push(p);
  return acc;
}, []);
---
<Base title="Our Team" description="The SASE Purdue executive board, cabinet, and advisors.">
  <div class="alignwide">
    <h1 class="page-title">Our Team</h1>
    {sections.map(s => (
      <section class="board-section">
        <h2>{s.name}</h2>
        {rows(s.people).map(row => (
          <div class="board-row">
            {row.map(p => (
              <figure class="person">
                {p.photo && <img src={`${base}${p.photo}`} alt={p.name}
                                 width="430" height="430" loading="lazy" />}
                <figcaption>
                  <strong>{p.name}</strong>
                  {p.role}
                  {p.study && <em>{p.study}</em>}
                </figcaption>
              </figure>
            ))}
          </div>
        ))}
      </section>
    ))}
  </div>
</Base>
